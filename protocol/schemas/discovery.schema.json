{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigeonsms.com/protocol/v1/discovery.schema.json",
  "title": "Pigeon server discovery",
  "type": "object",
  "required": ["protocol", "server", "endpoints", "capabilities", "limits"],
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["name", "versions", "preferred"],
      "properties": {
        "name": { "const": "open-pigeon" },
        "versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } },
        "preferred": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "endpoints": {
      "type": "object",
      "required": ["api", "gateway", "media"],
      "properties": {
        "api": { "type": "string", "format": "uri" },
        "gateway": { "type": "string", "pattern": "^wss?://" },
        "media": { "type": "string", "format": "uri" },
        "calls": { "type": "string", "pattern": "^wss?://" }
      },
      "additionalProperties": true
    },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" } },
    "limits": {
      "type": "object",
      "required": ["message_length", "upload_bytes"],
      "properties": {
        "message_length": { "type": "integer", "minimum": 1 },
        "upload_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
