{
  "name": "pigeonsms-web",
  "private": true,
  "version": "3.0.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:sync": "vitest run src/lib/messageSync.test.ts",
